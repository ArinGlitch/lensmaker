    "@google/genai": "1.5.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@prisma/client": "6.19.3",
    "@tanstack/react-query": "5.90.20",
    "bcryptjs": "2.4.3",
    "jose": "6.0.11",
    "next": "15.5.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "2.15.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
